# Salin ke `.env` lalu isi nilainya. JANGAN commit `.env`.
#
#   cp .env.example .env
#   export $(grep -v '^#' .env | xargs)   # atau pakai direnv / dotenv
#
# Hanya dibutuhkan kalau memakai `--llm` atau `--llm-discover`.

# API key untuk endpoint OpenAI-compatible.
LELUHUR_API_KEY=sk-xxxxxxxxxxxxxxxxxxxxxxxx

# Opsional: timpa base URL (harus berakhir dengan /v1).
# LELUHUR_BASE_URL=https://leluhurcy.us.ci/v1

# Opsional: timpa nama model.
# ZHONGKUI_MODEL=ds-meji
